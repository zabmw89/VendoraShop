# Django
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key-at-least-32-chars
ALLOWED_HOSTS=127.0.0.1,localhost

# Google OAuth (from Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Apple OAuth (from Apple Developer → Certificates, Identifiers & Profiles)
# APPLE_CLIENT_ID=com.yourapp.service
# APPLE_CLIENT_SECRET=xxxxx
# APPLE_KEY_ID=xxxxx
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----

# Email (console backend prints to terminal in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# CORS (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Database (leave empty for SQLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/vendorashop

# Payments (Stripe) — leave blank to use the built-in mock provider
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx   # from `stripe listen` or the Dashboard
# PAYMENT_CURRENCY=USD

# Demo mode (set to true to seed demo data)
DEMO_MODE=false
# Demo credentials (published defaults; override for a private deployment)
# DEMO_ADMIN_PASSWORD=DemoAdmin123!
# DEMO_CUSTOMER_PASSWORD=DemoUser123!
